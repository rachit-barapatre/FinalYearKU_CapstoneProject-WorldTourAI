# LLM — OpenRouter free models only. The app will not switch to a paid model.
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free

# Flights — Aviationstack free plan (personal / non-commercial, limited monthly quota)
AVIATIONSTACK_API_KEY=

# Places
GEOAPIFY_API_KEY=

# Routing
OSRM_BASE_URL=https://router.project-osrm.org

# Providers
FLIGHT_PROVIDER=aviationstack
HOTEL_PROVIDER=openrouter
WEATHER_PROVIDER=open_meteo
ROUTING_PROVIDER=osrm
PLACES_PROVIDER=geoapify
CURRENCY_PROVIDER=frankfurter

# Runtime
USE_MOCK_FALLBACK=true
DEBUG_MODE=false

MAX_RETRY_ATTEMPTS=2
MAX_REPLAN_ATTEMPTS=2

# Live Google Flights fares + Google Hotels rates (free plan: 250 searches/month) — https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

# Chat translation (Hindi, Gujarati, Marathi) — MyMemory free API, no key needed: https://mymemory.translated.net/doc/spec.php
# Optional: an email address raises the free daily limit from about 5,000 to 50,000 words.
MYMEMORY_EMAIL=efree56@gmail.com

# Agent logs (utils/agent_logs.py). Every agent run and outside API call is logged as one JSON line
# to stdout (Vercel → Logs) and, locally, to ai_backend/logs/agents-YYYY-MM-DD.jsonl.
# Summarise them with: python scripts/agent_report.py --help
# AGENT_LOG_FILE=0        turn off the local files
# AGENT_LOG_DIR=          write the files to another folder

# Skip the free LLM for this many seconds after it fails or is too slow (0 = never skip). Default 300.
# LLM_COOLDOWN_SECONDS=300
# Day-by-day step: the timetable is built without the AI; the AI only writes the day text, in small parallel requests.
# AI_DESCRIPTION_TIMEOUT_SECONDS=25
# AI_DAYS_PER_REQUEST=2
# AI_PARALLEL_REQUESTS=4
# AI_DESCRIPTION_RETRIES=1
# AI_DAY_DESCRIPTIONS=true            false = skip the AI-written day text (fastest plans)
# PARSER_LLM_WAIT_SECONDS=20          how long the chat waits for the AI to read a message

# Optional web-API protection (see README). All empty / unset = open API, CORS allows any origin.
# ACCESS_CODE=                        visitors must send it in the X-Access-Code header
# ALLOWED_ORIGINS=                    comma-separated frontend URLs allowed by CORS, e.g. https://worldtour-xi.vercel.app
# UPSTASH_REDIS_REST_URL=             with the token below: per-visitor daily limit on plans
# UPSTASH_REDIS_REST_TOKEN=
# PLANS_PER_DAY=10
# CACHE_DIR=                          where API responses are cached (default ai_backend/.cache, /tmp on Vercel)
